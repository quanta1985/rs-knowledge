---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CHAPTERS, type Part } from '../../data/chapters';
import { LANGS, t, url, type Lang } from '../../i18n/ui';

export const getStaticPaths = () => LANGS.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const vi = lang === 'vi';
const entries = (await getCollection('chapters')).filter((e) => e.id.startsWith(`${lang}/`));
const byId = new Map(entries.map((e) => [e.id, e]));
const nFigures = entries.reduce((s, e) => s + (e.body?.match(/<Figure\b/g)?.length ?? 0), 0);
const quizzes = Object.values(import.meta.glob<{ default: unknown[] }>('../../data/quiz/*.json', { eager: true }));
const nQuiz = quizzes.reduce((s, q) => s + q.default.length, 0);
const first = CHAPTERS.find((c) => byId.has(`${lang}/${c.slug}`));
const pad = (n: number) => String(n).padStart(2, '0');
const parts: { p: Part; key: 'partA' | 'partB' | 'partC'; desc: string }[] = [
  { p: 'A', key: 'partA', desc: vi ? 'Từ quỹ đạo, phóng, vận hành đến truyền tín hiệu, chòm sao LEO và định vị GNSS.' : 'From orbits, launch and operations to signals, LEO constellations and GNSS positioning.' },
  { p: 'B', key: 'partB', desc: vi ? 'Vật lý, cảm biến, chỉ số phổ, tiền xử lý, phân loại, biến động, radar và DEM trên ảnh thật Việt Nam.' : 'Physics, sensors, indices, pre-processing, classification, change, radar and DEMs on real imagery of Viet Nam.' },
  { p: 'C', key: 'partC', desc: vi ? 'Case study Việt Nam, Google Earth Engine, bài thực hành và bảng tra cứu.' : 'Viet Nam case studies, Google Earth Engine, labs and reference tables.' },
];
const stats: [string, string][] = [
  [String(CHAPTERS.length), vi ? 'chương' : 'chapters'],
  [String(nFigures), vi ? 'mô phỏng & bản đồ' : 'simulations & maps'],
  [String(nQuiz), vi ? 'câu hỏi ôn tập' : 'review questions'],
];
---
<Base lang={lang} title={t(lang, 'siteTitle')}>
  <main id="main" class="home">
    <section class="home-hero">
      <div>
        <p class="mono-label">{vi ? 'Sổ tay tương tác · Song ngữ Việt – Anh' : 'Interactive handbook · Vietnamese – English'}</p>
        <h1>{vi ? <>Vệ tinh, viễn thám<br />& GIS cho Việt Nam</> : <>Satellites, remote sensing<br />& GIS for Viet Nam</>}</h1>
        <p class="lead">{t(lang, 'tagline')}</p>
        <div class="cta">
          {first && <a class="btn primary" href={url(`${lang}/${first.slug}/`)}>{vi ? 'Bắt đầu đọc' : 'Start reading'}</a>}
          <a class="btn" href={url(`${lang}/ch15-labs/`)}>{vi ? 'Bài thực hành' : 'Labs'}</a>
          <a class="btn" href={url(`${lang}/glossary/`)}>{t(lang, 'glossary')}</a>
        </div>
        <dl class="home-stats">{stats.map(([v, k]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
      </div>
      <figure class="hero-shot">
        <img src={url('img/hero-s2-cir.webp')} width="1024" height="1024" alt={vi ? 'Ảnh Sentinel-2 hồng ngoại giả khu Hồ Tây – sông Hồng, Hà Nội, 12/02/2024' : 'Sentinel-2 false-colour infrared image of West Lake – Red River, Hanoi, 12 Feb 2024'} fetchpriority="high" />
        <img class="inset" src={url('img/hero-s1-vv.webp')} width="1024" height="1024" alt={vi ? 'Cùng khung trên ảnh radar Sentinel-1 VV' : 'The same frame in a Sentinel-1 VV radar image'} loading="lazy" />
        <div class="hero-hud stat-panel">
          <p class="stat-title">Sentinel-2B · 12/02/2024</p>
          <dl>
            <div><dt>{vi ? 'Khung' : 'Frame'}</dt><dd>5,12 × 5,12 km</dd></div>
            <div><dt>Pixel</dt><dd class="tone-accent">10 m</dd></div>
            <div><dt>{vi ? 'Tổ hợp' : 'Bands'}</dt><dd>B8 · B4 · B3</dd></div>
          </dl>
        </div>
        <figcaption>{vi ? 'Hồ Tây – sông Hồng: hồng ngoại giả (Sentinel-2) và radar VV (Sentinel-1) cùng một ngày.' : 'West Lake – Red River: false-colour infrared (Sentinel-2) and VV radar (Sentinel-1) on the same day.'}</figcaption>
      </figure>
    </section>

    {parts.map(({ p, key, desc }) => (
      <section class="part" aria-labelledby={`part-${p}`}>
        <div class="part-head"><h2 id={`part-${p}`}>{t(lang, key)}</h2><p>{desc}</p></div>
        <div class="cards">
          {CHAPTERS.filter((c) => c.part === p).map((c) => {
            const e = byId.get(`${lang}/${c.slug}`);
            return e ? (
              <a class="card" href={url(`${lang}/${c.slug}/`)}>
                <span class="mono-label">{t(lang, 'chapter')} {pad(c.n)}</span><strong>{c.title[lang]}</strong><p>{e.data.summary}</p>
              </a>
            ) : (
              <div class="card planned" aria-disabled="true">
                <span class="mono-label">{t(lang, 'chapter')} {pad(c.n)} · {t(lang, 'planned')}</span><strong>{c.title[lang]}</strong>
              </div>
            );
          })}
        </div>
      </section>
    ))}
  </main>
</Base>
