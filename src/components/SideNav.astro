---
import { getCollection } from 'astro:content';
import { CHAPTERS, type Part } from '../data/chapters';
import { t, url, type Lang } from '../i18n/ui';

interface Props { lang: Lang; current?: string }
const { lang, current } = Astro.props;
const ready = new Set((await getCollection('chapters')).map((e) => e.id));
const parts: [Part, 'partA' | 'partB' | 'partC'][] = [['A', 'partA'], ['B', 'partB'], ['C', 'partC']];
---
<nav class="sidenav" aria-label={t(lang, 'chapters')}>
  <details open>
    <summary class="hide-lg" style="cursor:pointer;font-weight:600">{t(lang, 'chapters')}</summary>
    {parts.map(([p, key]) => (
      <>
        <h4>{t(lang, key)}</h4>
        <ol>
          {CHAPTERS.filter((c) => c.part === p).map((c) => (
            <li>
              {ready.has(`${lang}/${c.slug}`)
                ? <a href={url(`${lang}/${c.slug}/`)} aria-current={c.slug === current ? 'page' : undefined}>{c.n}. {c.title[lang]}</a>
                : <span title={t(lang, 'planned')}>{c.n}. {c.title[lang]}</span>}
            </li>
          ))}
        </ol>
      </>
    ))}
    <h4>{t(lang, 'depthRef')}</h4>
    <ol><li><a href={url(`${lang}/glossary/`)}>{t(lang, 'glossary')}</a></li></ol>
  </details>
</nav>
<style>
  @media (min-width: 1000px) { .hide-lg { display: none; } }
</style>
